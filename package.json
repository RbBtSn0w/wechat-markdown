{
  "name": "@rbbtsn0w/wechat-markdown",
  "version": "1.7.1",
  "description": "High-fidelity Markdown to WeChat Official Account HTML converter SDK & middleware",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RbBtSn0w/wechat-markdown.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts' 'scripts/**/*.{js,cjs,mjs}' --no-error-on-unmatched-pattern --max-warnings=0",
    "format": "prettier --write .github/workflows/*.yml .releaserc.json package.json tsconfig*.json vitest.config.mts .eslintrc.js src/ test/ scripts/ docs/",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "format:check": "prettier --check .github/workflows/*.yml .releaserc.json package.json tsconfig*.json vitest.config.mts .eslintrc.js src/ test/ scripts/ docs/",
    "verify:package": "node scripts/verify-package.mjs",
    "test:package": "node scripts/verify-package.mjs"
  },
  "keywords": [
    "markdown",
    "wechat",
    "wechat-mp",
    "juice",
    "inliner",
    "converter",
    "sdk",
    "middleware",
    "latex",
    "mermaid"
  ],
  "author": "RbBtSn0w",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.6",
    "highlight.js": "^11.12.0",
    "juice": "^12.2.0",
    "marked": "^12.0.2",
    "mathjax-full": "^3.2.2",
    "pako": "^3.0.2",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "yaml": "^2.8.2",
    "cheerio": "^1.2.0",
    "htmlparser2": "^12.0.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "source-map-js": "^1.2.2",
    "ip-address": "^10.7.3",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@semantic-release/github": "^12.0.0",
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "^2.16.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "ip-address": "^10.7.3",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "@commitlint/lint": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "import-from-esm": "2.0.0",
    "publint": "0.3.25",
    "conventional-changelog-conventionalcommits": "9.3.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/release-notes-generator": "^14.1.1"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22.14.0"
  }
}
