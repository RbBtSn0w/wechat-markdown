{
  "name": "@rbbtsn0w/wechat-markdown",
  "version": "1.1.1",
  "description": "High-fidelity Markdown to WeChat Official Account HTML converter SDK & middleware",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RbBtSn0w/wechat-markdown.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.{ts,js}'",
    "format": "prettier --write 'src/**/*.{ts,js}'"
  },
  "keywords": [
    "markdown",
    "wechat",
    "wechat-mp",
    "juice",
    "inliner",
    "converter",
    "sdk",
    "middleware",
    "latex",
    "mermaid"
  ],
  "author": "RbBtSn0w",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.6",
    "juice": "^10.0.1",
    "marked": "^12.0.2",
    "mathjax-full": "^3.2.2",
    "pako": "^2.1.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.0.0",
    "@semantic-release/npm": "^13.1.5",
    "@types/marked": "^6.0.0",
    "@types/node": "^20.19.37",
    "@types/pako": "^2.0.4",
    "@types/sanitize-html": "^2.16.0",
    "@types/yaml": "^1.9.7",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  },
  "type": "commonjs"
}
